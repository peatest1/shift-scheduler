rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // users: a user can create/read only their own profile doc; admins can read all
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update, delete: if isAdmin();
    }

    // groups, staff, holidays, schedules: any signed-in user can read,
    // only admins can write
    match /groups/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /staff/{id} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin();
      // allow the staff-registration flow to attach linkedUid to their own record
      allow update: if isAdmin() ||
        (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['linkedUid']));
    }
    match /holidays/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /schedules/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
